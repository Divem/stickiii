{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "仅允许本地主窗口管理便签库和全局设置；文件、网络、窗口和快捷键通过 Rust 的专用命令处理。",
  "windows": ["main"],
  "permissions": [
    "allow-get-window-context", "allow-set-window-title", "allow-open-note-window", "allow-focus-note-window", "allow-open-main-window",
    "allow-list-notes", "allow-save-note", "allow-delete-note", "allow-pick-files", "allow-import-attachment", "allow-open-attachment", "allow-open-external-link",
    "allow-list-sync-configs", "allow-save-sync-config", "allow-clear-sync-config", "allow-list-shortcuts", "allow-save-shortcuts",
    "allow-get-ai-config", "allow-save-ai-config", "allow-clear-ai-config", "allow-polish-note", "allow-ai-note",
    "allow-test-ai-connection",
    "allow-set-pinned-window", "allow-minimize-window", "allow-hide-window", "allow-start-dragging", "allow-ready-window", "allow-complete-exit", "allow-request-exit",
    "allow-sync-begin", "allow-sync-checkpoint", "allow-sync-finish", "allow-feishu-request"
  ]
}
