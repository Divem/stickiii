{
  "name": "desk-tabs",
  "displayName": "贴贴便签",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "从任意窗口快速打开的桌面随手记",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "tauri": "tauri",
    "build": "tauri build --no-bundle",
    "icons": "node scripts/generate-icons.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:win": "tauri build --bundles nsis",
    "package:win:managed": "tauri build --bundles nsis --config src-tauri/tauri.managed.conf.json",
    "package:win:offline": "tauri build --bundles nsis --config src-tauri/tauri.offline.conf.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:contracts": "node --import tsx --test scripts/*.test.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.1",
    "lucide-react": "^0.562.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
